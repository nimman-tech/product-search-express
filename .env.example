# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"your-key","client_email":"your-email"}

# Turso Database Configuration
TURSO_CONNECTION_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-token
SQLITE_DB_PATH=file:./sqlite/products-local.db
# CORS Configuration
CORS_ORIGINS=http://localhost:4200,https://nimman.in

# Environment
NODE_ENV=development
PORT=3000

# Product Search Configuration
MIN_LAUNCH_YEAR=2020
MIN_LAUNCH_YEAR_MOBILE=2020
MIN_LAUNCH_YEAR_CAR=2020

# Cuelinks & Redirect Configuration
CUELINKS_CHANNEL_ID=YOUR_CUELINKS_CHANNEL_ID
CUELINKS_PUB_ID=YOUR_CUELINKS_PUB_ID
CUELINKS_BASE_URL=https://linksredirect.com/
# Optional: Comma-separated list of allowed merchant domains (defaults to standard merchants if omitted)
ALLOWED_MERCHANT_DOMAINS=amazon.in,amzn.to,flipkart.com,fkrt.it,tatacliq.com,myntra.com,ajio.com,croma.com,reliancedigital.in,jiomart.com,vijaysales.com
